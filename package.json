{
  "name": "roy",
  "version": "0.1.2",
  "description": "Roy，为专业用户设计的 Agent",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter='@roy/electron' dev",
    "electron:dev": "bun run --filter='@roy/electron' dev",
    "electron:build": "bun run --filter='@roy/electron' build",
    "electron:start": "bun run --filter='@roy/electron' start",
    "dist:mac": "bun run --filter='@roy/electron' dist:mac",
    "dist:win": "bun run --filter='@roy/electron' dist:win",
    "dist:linux": "bun run --filter='@roy/electron' dist:linux",
    "build": "bun run --filter='*' build",
    "typecheck": "bun run --filter='*' typecheck",
    "test": "bun test --isolate"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "dompurify": "^3.4.2",
    "electron-builder": "^25.1.8",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "ink-mde": "0.33.0",
    "jotai": "^2.17.1",
    "jotai-family": "^1.1.0",
    "node-cron": "^4.6.0",
    "reactflow": "^11.11.4"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0"
  },
  "patchedDependencies": {
    "@earendil-works/pi-ai@1.3.0": "patches/@earendil-works%2Fpi-ai@1.3.0.patch",
    "@earendil-works/pi-coding-agent@1.3.0": "patches/@earendil-works%2Fpi-coding-agent@1.3.0.patch",
    "node-pty@1.1.0": "patches/node-pty@1.1.0.patch"
  }
}
